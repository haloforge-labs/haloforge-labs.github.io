---
import SiteLayout from '../layouts/SiteLayout.astro';
import Owl from '../components/Owl.astro';
---
<SiteLayout title="Page not found" description="This page is not here. Go to the home page.">
  <h1>Page not found</h1>
  <div class="missing-owl"><Owl size={88} /></div>
  <p>This page is not here. The owl looked everywhere.</p>
  <p><a href="/">Go to the home page</a></p>
</SiteLayout>
<style>
  .missing-owl { color: var(--accent); margin-block: 24px; }
</style>
