---
import SiteLayout from '../layouts/SiteLayout.astro';
import Measurements from '../components/Measurements.astro';
---
<SiteLayout title="Halowin Bubo: a local LLM server for Windows on AMD Strix Halo" description="Halowin Bubo is an open-source, native Windows LLM server built on gufo for AMD Strix Halo laptops at about 70 W. Download v0.1.0, read the benchmarks and the setup guides.">
  <section class="home-intro" aria-labelledby="home-title">
    <span class="eyebrow">Open source · Native Windows · AMD Strix Halo</span>
    <h1 id="home-title">The most intelligence a laptop can fit</h1>
    <p class="intro">Halowin Bubo (Halo plus Windows) runs Qwen3.8 Flash Next natively on AMD Strix Halo laptops. It is open source and built on gufo, from HaloForge Labs. Decode at 55 tok/s and prefill at 1,300 tok/s at only 70 W.</p>
    <div class="cta-row"><a class="button" href="https://github.com/haloforge-labs/bubo/releases/tag/v0.1.0">Download v0.1.0 for Windows</a><a class="cta-link" href="/docs/system-setup/">System setup <span aria-hidden="true">→</span></a></div>
    <p class="card-note">MIT licence. First release (v0.1.0): see the <a href="/docs/known-issues/">known issues</a>.</p>
  </section>
  <section aria-label="Halowin Bubo benchmarks">
    <Measurements compact />
    <p class="measure-note">Measured on an ASUS ProArt PX13 with 128 GB, Windows 11, Performance mode, about 70 W, with Qwen3.8 Flash Next UD-Q4_K_XL.</p>
    <a href="/docs/benchmarks/">Read the benchmark details <span aria-hidden="true">→</span></a>
  </section>
</SiteLayout>
