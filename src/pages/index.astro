---
import SiteLayout from '../layouts/SiteLayout.astro';
import Measurements from '../components/Measurements.astro';
---
<SiteLayout title="Home" description="HaloForge Labs. Halowin Bubo, a native Windows LLM server built on gufo and tuned for AMD Strix Halo laptops at about 70 W.">
  <section class="home-intro" aria-labelledby="home-title">
    <span class="eyebrow">Local models · Windows</span>
    <h1 id="home-title">HaloForge Labs</h1>
    <p class="intro">HaloForge Labs makes Halowin Bubo, a native Windows LLM server for AMD Strix Halo laptops. The name joins Halo and Windows. Bubo is open source and built on gufo. It uses AMD HIP and runs at about 70 W.</p>
  </section>
  <article class="product-card" aria-labelledby="bubo-title">
    <div>
      <span class="eyebrow">LLM server</span>
      <h2 id="bubo-title">Halowin Bubo</h2>
      <div class="card-summary">An owl. A Windows server.</div>
    </div>
    <div class="card-content">
      <div class="card-links"><a href="/bubo/">Explore Halowin Bubo <span aria-hidden="true">→</span></a><a href="/docs/system-setup/">System setup <span aria-hidden="true">→</span></a></div>
    </div>
  </article>
  <section aria-label="Halowin Bubo benchmarks">
    <Measurements compact />
    <a href="/docs/benchmarks/">Read the benchmark details <span aria-hidden="true">→</span></a>
  </section>
</SiteLayout>
