---
import SiteLayout from '../layouts/SiteLayout.astro';
import { ENGINES, FILES, LOADS, ROWS, fmt, cell, cellShort } from '../data/rb';
import QuantChart from '../components/QuantChart.astro';

const DOWNLOAD = 'https://github.com/haloforge-labs/bubo/releases/tag/v0.1.2';

const rows = ROWS.filter(r => r.front);
const rivals = ENGINES.filter(e => e.id !== 'R');
// Front table: Q4_K_XL, the one file every engine runs. The lower-memory files get the chart below. Fast mode gets a column when any row has a value.
const frontFiles = FILES.filter(f => f.id === 'q4' && rows.some(r => r.arms[f.id]));
const frontFast = rows.some(r => frontFiles.some(f => r.arms[f.id]?.fastTok !== undefined));
const frontCols = 1 + 1 + rivals.length;
---
<SiteLayout title="Halowin Bubo: a local LLM server for AMD Strix Halo on Windows" description="Halowin Bubo runs Qwen3.8 Flash Next (125B parameters, 6B active) on AMD Strix Halo laptops at about 70 W. Native on Windows, free, OpenAI-compatible.">
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-main">
      <span class="eyebrow">v0.1.2 · MIT · Windows 11</span>
      <p class="display">The most intelligence a laptop can fit</p>
      <h1 id="home-title">A local LLM server for AMD Strix Halo, native on Windows</h1>
      <p class="intro">Halowin Bubo runs Qwen3.8 Flash Next on your laptop. The new app helps you download the model, starts it and shows what it uses. Version 0.1.2 runs the <a href="https://huggingface.co/ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF">ISTA GSQ-RCO</a> files IQ3_S, IQ3_XXS, IQ2_XS and the Flash Next Coder as published. It adds an optional fast mode for prompts of 4,096 or more new tokens, a smaller context cache and in-engine abliteration, off by default.</p>
      <div class="cta-row"><a class="button" href={DOWNLOAD}>Download v0.1.2 for Windows</a><a class="cta-link" href="/docs/system-setup/">System setup <span aria-hidden="true">→</span></a></div>
      <p class="feature-line">OpenAI-compatible API · tool calling · up to 262K context · tested with the Pi coding agent</p>
      <p class="needs">Needs Windows 11 and an AMD Strix Halo machine. Qwen3.8 Flash Next needs 128 GB of memory and about 113 GiB of free disk. Smaller models need less. On a 96 GB machine, use a <a href="/models/">lower-memory model</a>: the lower-memory build, an ISTA file or the Coder. MIT license. See the <a href="/docs/known-issues/">known issues</a>.</p>
    </div>
    <div class="hero-stats">
      <p class="proof"><strong>Qwen3.8 Flash Next: 125B parameters</strong> (6B active) at <a href="/docs/system-setup/#power-mode">about 70 W</a></p>
      <p class="chart-stat"><span class="chart-num">66.2</span> <span class="chart-unit">tok/s</span></p>
      <p class="chart-claim">writing, in a long agent session at about 70 W</p>
      <p class="chart-stat second"><span class="chart-num">1,639</span> <span class="chart-unit">tok/s</span></p>
      <p class="chart-claim">reading a 32K prompt, with fast mode</p>
      <aside class="newbox" aria-labelledby="news-title">
        <h2 id="news-title">New in 0.1.2</h2>
        <ul>
          <li><strong>ISTA quants, a lot less memory.</strong> Bubo reads ISTA-DASLab’s IQ3_S, IQ3_XXS and IQ2_XS files, and the Flash Next Coder. On ISTA’s benchmarks IQ3_S scores 93.26 against 93.12 for full precision.</li>
          <li><strong>Fast mode.</strong> About 16 % faster reading of prompts with 4,096 or more new tokens (1,718 instead of 1,482 tok/s at 22K), with no noticeable reasoning regression.</li>
          <li><strong>Smaller context cache.</strong> Q8 makes the KV cache 47 % smaller: 1.1 GB instead of 1.9 GB per extra 64K session.</li>
          <li><strong>In-engine abliteration.</strong> Off by default. Removes refusals without needing an abliterated copy of the quants (Qwen3.8 Flash Next only).</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="versus" aria-labelledby="versus-title">
    <h2 id="versus-title">Faster on the same laptop</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col" rowspan="2"><span class="visually-hidden">Workload</span></th>
            <th scope="col" rowspan="2" class="us">Bubo 0.1.2</th>
            <th scope="colgroup" colspan={rivals.length} class="group">Other engines, tok/s</th>
          </tr>
          <tr>
            {rivals.map(e => <th scope="col"><a href={e.url}>{e.name}</a><br /><span class="sub">{e.sub}</span></th>)}
          </tr>
        </thead>
        <tbody>
          {frontFiles.map(file => {
            const loads = LOADS[file.id] ?? {};
            const fileRows = rows.filter(r => r.arms[file.id]);
            return (
              <>
                {frontFiles.length > 1 ? <tr class="file-row"><th scope="rowgroup" colspan={frontCols}>{file.title}</th></tr> : null}
                {fileRows.map(r => {
                  const a = r.arms[file.id]!;
                  return <tr><th scope="row">{r.front!.label}<span class="sub">{r.front!.what}</span></th><td class="us">{a.fastTok !== undefined ? <>{fmt(a.fastTok, r.decimals)}*</> : fmt(a.bubo, r.decimals)}</td>{rivals.map(e => <td class="ratio">{loads[e.id] ? 'does not load' : a.rival?.[e.id] !== undefined ? fmt(a.rival[e.id]!, r.decimals) : '–'}</td>)}</tr>;
                })}
              </>
            );
          })}
        </tbody>
      </table>
    </div>
    {frontFast ? <p class="measure-note">*Experimental fast mode for long prompts, off by default. Turn it on with <code>--prefill-mode fast</code> (in CLI), or with Prefill mode (in GUI).</p> : null}
    <p class="measure-note">Same laptop at about 70 W, same model file (Huihui UD-Q4_K_XL) for every engine. <a href="/benchmarks/">Method and every row <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="lowmem" aria-labelledby="lowmem-title">
    <QuantChart>
      <p class="lowmem-intro">Bubo also runs ISTA’s lower-memory files of the same model. They leave room for more sessions at longer context, a smaller GPU carve-out or other programs beside the model.</p>
    </QuantChart>
  </section>

  <section class="home-visual" aria-labelledby="start-title">
    <h2 id="start-title">Start in four steps</h2>
    <div class="steps">
      <div class="step"><div class="step-head"><span>1. <a href="/docs/install/#prepare-the-machine">Prepare the machine</a>: GPU memory, page file, power mode</span></div></div>
      <div class="step"><div class="step-head"><span>2. Download the zip and unzip it</span></div></div>
      <div class="step"><div class="step-head"><span>3. Double-click <code>start.cmd</code></span></div></div>
      <div class="step"><div class="step-head"><span>4. Approve the download, then press Start</span></div></div>
    </div>
    <p class="measure-note"><a href="/docs/install/">Install guide <span aria-hidden="true">→</span></a></p>
  </section>
</SiteLayout>
<style>
  :global(main) { padding-top: 44px; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 56px; align-items: start; padding-bottom: 54px; }
  .hero-main { min-width: 0; }
  .display { font-size: clamp(2.5rem, 4.8vw, 4.2rem); line-height: 1.05; font-style: italic; color: var(--accent); letter-spacing: -.025em; margin: 14px 0 12px; max-width: 14em; }
  .proof { margin: 0 0 26px; font-size: 1.25rem; padding-left: 14px; border-left: 3px solid var(--accent); line-height: 1.35; }
  .proof strong { font-weight: 700; }
  .hero h1 { font-size: clamp(1.15rem, 1.7vw, 1.4rem); font-style: normal; color: var(--ink); letter-spacing: 0; margin: 0 0 10px; line-height: 1.3; }
  .hero .intro { font-size: 1.1rem; line-height: 1.6; max-width: 640px; margin-bottom: 0; }
  .feature-line { margin: 18px 0 0; font-size: 1rem; color: var(--muted); line-height: 1.5; }
  .needs { margin: 10px 0 0; font-size: .95rem; color: var(--muted); line-height: 1.5; max-width: 640px; }
  .hero-stats { min-width: 0; padding-top: 6px; }
  .chart-stat { margin: 0; line-height: 1; }
  .chart-stat.second { margin-top: 16px; }
  .chart-num { color: var(--accent); font-size: clamp(2.3rem, 3.9vw, 3.3rem); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .chart-unit { font-size: 1.15rem; color: var(--ink); }
  .chart-claim { margin: 4px 0 12px; font-size: 1.05rem; line-height: 1.4; }
  .versus { padding-top: 6px; }
  .table-wrap { overflow-x: auto; }
  .versus table { border-collapse: collapse; width: 100%; max-width: 900px; font-variant-numeric: tabular-nums; }
  .versus th, .versus td { padding: 11px 16px; border-bottom: 1px solid var(--line); text-align: right; font-size: 1.05rem; line-height: 1.35; vertical-align: top; }
  .versus thead th { font-weight: 400; vertical-align: bottom; }
  .versus th[scope='row'] { text-align: left; font-weight: 400; }
  .versus tr.file-row th { text-align: left; font-weight: 700; font-size: .92rem; color: var(--muted); padding-top: 22px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .versus .sub { display: block; font-size: .82rem; color: var(--muted); }
  .versus .us { background: var(--tint); }
  .versus thead .us { color: var(--accent); font-weight: 700; }
  .versus td.us { color: var(--accent); }
  .versus .fast { white-space: nowrap; }
  .versus td.ratio { color: var(--accent); white-space: nowrap; }
  .versus thead th.group { text-align: center; border-bottom: 1px solid var(--line); color: var(--muted); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  section + section { margin-top: 40px; }
  .lowmem-intro { max-width: 58em; line-height: 1.45; margin: 0 0 .8em; }
  .newbox { margin-top: 22px; padding: 12px 16px 6px; border: 1px solid var(--line); border-radius: 6px; background: var(--wash); font-size: .88rem; line-height: 1.4; }
  .newbox h2 { margin: 0 0 6px; font-size: 1rem; }
  .newbox ul { margin: 0; padding-left: 1.1rem; }
  .newbox li { margin-bottom: 7px; font-size: .85rem; }
  .home-visual { margin-top: 56px; }
  .steps { max-width: 820px; display: grid; gap: 12px; }
  .step { min-width: 0; border: 1px solid var(--line); border-radius: 6px; background: var(--wash); }
  .step-head { padding: 12px 16px; font-size: 1.05rem; }
  code { font: .92em var(--mono); }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 36px; }
  }
  @media (max-width: 560px) {
    .versus th, .versus td { padding: 9px 8px; font-size: .95rem; }
    .versus .sub { font-size: .75rem; }
  }
</style>
