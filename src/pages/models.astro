  ['Qwen3.8 Flash Next (Huihui)', 'Mixture of experts, 4-bit', '116.6 GB', 'Yes', 'Yes'],
  ['Qwen3.8 Flash Next (original)', 'Mixture of experts, 4-bit', '116.6 GB', 'Yes', 'Yes'],
  ['Qwen3.8 Flash Next Huihui (lower memory)', 'Mixture of experts, mixed formats. About 66 GiB of GPU memory', '89.9 GB', 'Yes', 'Yes'],
  ['Qwen3.8 27B', 'Dense, 4-bit', '19.6 GB', 'Yes', 'Yes'],
  ['Qwen3.6 27B', 'Dense, 4-bit', '18.5 GB', 'Yes', 'No'],
  ['Cyber-Tiel Coder 35B-A3B', 'Mixture of experts, for code, 4-bit', '23.4 GB', 'Yes', 'No'],
  ['Gemma 4 26B-A4B (Unsloth QAT)', 'Mixture of experts, 4-bit', '15.7 GB', 'Yes', 'Yes'],
  ['Gemma 4 31B (Unsloth QAT)', 'Dense, 4-bit', '18.8 GB', 'Yes', 'Yes'],
  ['Gemma 4 26B-A4B uncensored (Huihui, QAT)', 'Mixture of experts, 4-bit', '18.8 GB', 'Yes', 'Yes'],
