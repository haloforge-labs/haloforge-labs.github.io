---
import Brand from '../components/Brand.astro';
import '../styles/theme.css';
import '../styles/site.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HaloForge Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL('/og-card.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Halowin Bubo from HaloForge Labs: a local LLM server for AMD Strix Halo, native on Windows. 51–55 tok/s decode, 29/35 on reasoning checks, 1,364 tok/s prefill, at about 70 W." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-card.png', Astro.site)} />
    <meta name="twitter:image:alt" content="Halowin Bubo from HaloForge Labs: a local LLM server for AMD Strix Halo, native on Windows. 51–55 tok/s decode, 29/35 on reasoning checks, 1,364 tok/s prefill, at about 70 W." />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#faf8f1" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : saved === 'light' ? 'light' : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } catch {}
    </script>
  </head>
  <body class="site">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <Brand />
      <nav aria-label="Main navigation">
        <a href="/bubo/" aria-current={path === '/bubo/' ? 'page' : undefined}>Halowin Bubo</a>
        <a href="/docs/">Docs</a>
        <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a>
        <a class="nav-download" href="https://github.com/haloforge-labs/bubo/releases/tag/v0.1.0">Download</a>
        <button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" /></svg><span>Theme</span></button>
      </nav>
    </header>
    <main class="shell" id="main"><slot /></main>
    <footer class="site-footer shell">
      <span>HaloForge Labs</span>
      <nav aria-label="Project links">
        <a href="https://github.com/haloforge-labs/bubo">GitHub</a>
        <a href="https://huggingface.co/HaloForgeLabs/bubo-qwen3.8-flash-next">Hugging Face</a>
        <a href="https://github.com/haloforge-labs/bubo/blob/main/LICENSE">License (MIT)</a>
        <a href="https://github.com/haloforge-labs/bubo/blob/main/RELEASE-NOTES.md">Release notes</a>
        <a href="https://github.com/haloforge-labs/bubo/releases/download/v0.1.0/SHA256SUMS.txt">SHA256SUMS</a>
      </nav>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      button?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('starlight-theme', theme); } catch {}
      });
    </script>
  </body>
</html>
